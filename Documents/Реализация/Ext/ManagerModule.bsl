#Область ПрограммныйИнтерфейс

// Формирует табличный документ расходной накладной по макету «ПечатьНакладная».
//
// Параметры:
//   СсылкаНаДокумент - ДокументСсылка.Реализация - документ, для которого формируется печатная форма.
//
// Возвращаемое значение:
//   ТабличныйДокумент - сформированная печатная форма.
//
Функция СформироватьПечатнуюФорму(СсылкаНаДокумент) Экспорт
	
#Область ИнициализацияТабличногоДокумента

	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.ОтображатьСетку = Ложь;
	ТабличныйДокумент.ОтображатьЗаголовки = Ложь;
	ТабличныйДокумент.ТолькоПросмотр = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСлева = 10;
	ТабличныйДокумент.ПолеСправа = 10;
	ТабличныйДокумент.ПолеСверху = 10;
	ТабличныйДокумент.ПолеСнизу = 10;

#КонецОбласти

#Область ЗаполнениеПечатнойФормы

	МакетПечатнойФормы = Документы.Реализация.ПолучитьМакет("ПечатьНакладная");
	
	// 1. Вывод шапки
	ОбластьШапка = МакетПечатнойФормы.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = СсылкаНаДокумент.Номер;
	ОбластьШапка.Параметры.Дата = СсылкаНаДокумент.Дата;
	ОбластьШапка.Параметры.Контрагент = СсылкаНаДокумент.Контрагент;
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	// 2. Вывод шапки таблицы
	ОбластьШапкаТаблицы = МакетПечатнойФормы.ПолучитьОбласть("ШапкаТаблицы");
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	// 3. Вывод строк документа
	ОбластьСтрока = МакетПечатнойФормы.ПолучитьОбласть("Строка");
	ВсегоСумма = 0;
	
	Для Каждого СтрокаТовары Из СсылкаНаДокумент.Товары Цикл
		ОбластьСтрока.Параметры.НомерСтроки = СтрокаТовары.НомерСтроки;
		ОбластьСтрока.Параметры.Товар       = СтрокаТовары.Товар;
		ОбластьСтрока.Параметры.Количество  = СтрокаТовары.Количество;
		ОбластьСтрока.Параметры.Цена        = СтрокаТовары.Цена;
		ОбластьСтрока.Параметры.Сумма       = СтрокаТовары.Сумма;
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
		ВсегоСумма = ВсегоСумма + СтрокаТовары.Сумма;
	КонецЦикла;
	
	// 4. Вывод подвала
	ОбластьПодвал = МакетПечатнойФормы.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.ВсегоСумма = ВсегоСумма;
	ТабличныйДокумент.Вывести(ОбластьПодвал);

#КонецОбласти

	Возврат ТабличныйДокумент;
	
КонецФункции

#КонецОбласти
