#Область ПрограммныйИнтерфейс

// Формирует табличный документ расходной накладной по макету «ПечатьНакладная».
//
// Параметры:
//   СсылкаНаДокумент - ДокументСсылка.Реализация - документ, для которого формируется печатная форма.
//
// Возвращаемое значение:
//   ТабличныйДокумент - сформированная печатная форма.
//
Функция СформироватьПечатнуюФорму(СсылкаНаДокумент) Экспорт
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТабДокумент.ОтображатьСетку = Ложь;
	ТабДокумент.ОтображатьЗаголовки = Ложь;
	ТабДокумент.ТолькоПросмотр = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ПолеСлева = 10;
	ТабДокумент.ПолеСправа = 10;
	ТабДокумент.ПолеСверху = 10;
	ТабДокумент.ПолеСнизу = 10;
	
	Макет = Документы.Реализация.ПолучитьМакет("ПечатьНакладная");
	
	// 1. Вывод шапки
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапка.Параметры.Номер = СсылкаНаДокумент.Номер;
	ОбластьШапка.Параметры.Дата = СсылкаНаДокумент.Дата;
	ОбластьШапка.Параметры.Контрагент = СсылкаНаДокумент.Контрагент;
	ТабДокумент.Вывести(ОбластьШапка);
	
	// 2. Вывод шапки таблицы
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ТабДокумент.Вывести(ОбластьШапкаТаблицы);
	
	// 3. Вывод строк документа
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ВсегоСумма = 0;
	
	Для Каждого СтрТовары Из СсылкаНаДокумент.Товары Цикл
		ОбластьСтрока.Параметры.НомерСтроки = СтрТовары.НомерСтроки;
		ОбластьСтрока.Параметры.Товар       = СтрТовары.Товар;
		ОбластьСтрока.Параметры.Количество  = СтрТовары.Количество;
		ОбластьСтрока.Параметры.Цена        = СтрТовары.Цена;
		ОбластьСтрока.Параметры.Сумма       = СтрТовары.Сумма;
		
		ТабДокумент.Вывести(ОбластьСтрока);
		
		ВсегоСумма = ВсегоСумма + СтрТовары.Сумма;
	КонецЦикла;
	
	// 4. Вывод подвала
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал.Параметры.ВсегоСумма = ВсегоСумма;
	ТабДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабДокумент;
	
КонецФункции

#КонецОбласти
