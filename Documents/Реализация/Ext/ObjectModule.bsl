#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	// Включаем запись обоих регистров
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;
	
	// 1. Контроль остатков перед списанием
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокТовары.Товар КАК Товар,
		|	СУММА(ДокТовары.Количество) КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Реализация.Товары КАК ДокТовары
		|ГДЕ
		|	ДокТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ДокТовары.Товар
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Товар КАК Товар,
		|	ВТ.Товар.Представление КАК ТоварПредставление,
		|	ВТ.КоличествоВДокументе КАК Требуется,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток,
		|	ВТ.КоличествоВДокументе - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Нехватка
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&МоментВремени,
		|			Товар В
		|				(ВЫБРАТЬ
		|					ВТ_ТоварыДокумента.Товар
		|				ИЗ
		|					ВТ_ТоварыДокумента)) КАК Остатки
		|		ПО ВТ.Товар = Остатки.Товар
		|ГДЕ
		|	ВТ.КоличествоВДокументе > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Отказ = Истина;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = СтрШаблон(
				"Недостаточно товара «%1»! Требуется: %2, в наличии: %3 (не хватает: %4).",
				Выборка.ТоварПредставление,
				Выборка.Требуется,
				Выборка.Остаток,
				Выборка.Нехватка
			);
			Сообщить(ТекстСообщения);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	// 2. Формирование движений
	Для Каждого СтрокаТовары Из Товары Цикл
		
		// Движение по регистру остатков (Расход)
		ДвижениеОстатки = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатки.Период      = Дата;
		ДвижениеОстатки.Товар       = СтрокаТовары.Товар;
		ДвижениеОстатки.Количество  = СтрокаТовары.Количество;
		
		// Движение по регистру оборотов (Продажи)
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период     = Дата;
		ДвижениеПродажи.Товар      = СтрокаТовары.Товар;
		ДвижениеПродажи.Контрагент = Контрагент;
		ДвижениеПродажи.Количество = СтрокаТовары.Количество;
		ДвижениеПродажи.Сумма      = СтрокаТовары.Сумма;
		
	КонецЦикла;

КонецПроцедуры

#КонецОбласти