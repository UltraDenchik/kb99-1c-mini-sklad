#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
#Область ИнициализацияДвижений

	// Очистка старых движений при перепроведении выполняется автоматически платформой 
	// в соответствии со свойством «Удаление движений» (RegisterRecordsDeletion).
	// Включаем флаги записи для формируемых регистров:
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

#КонецОбласти

#Область БлокировкаДанных

	// Управляемая блокировка данных по регистру остатков для предотвращения коллизий при конкурентной записи
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	Блокировка.Заблокировать();

#КонецОбласти

#Область ПроведениеДокумента

	РезультатЗапросаПартий = ПолучитьОстаткиПартий();
	Если РезультатЗапросаПартий.Пустой() Тогда
		Возврат;
	КонецЕсли;

	// 1. Контроль остатков перед списанием
	ПроверитьОстаткиТоваров(Отказ, РезультатЗапросаПартий);
	Если Отказ Тогда
		Возврат;
	КонецЕсли;

	// 2. Списание партий по алгоритму FIFO (регистр ОстаткиТоваров)
	СписатьПартииПоFIFO(РезультатЗапросаПартий);

	// 3. Формирование движений по продажам (регистр Продажи)
	СформироватьДвиженияПоПродажам();

#КонецОбласти

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выполняет запрос к виртуальной таблице остатков с упорядочиванием по дате партии (FIFO).
//
// Возвращаемое значение:
//   РезультатЗапроса - результат выборки остатков партий по товарам документа.
//
Функция ПолучитьОстаткиПартий()
	
	ЗапросОстатковПартий = Новый Запрос;
	ЗапросОстатковПартий.Текст = 
		"ВЫБРАТЬ
		|	ДокТовары.Товар КАК Товар,
		|	СУММА(ДокТовары.Количество) КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Реализация.Товары КАК ДокТовары
		|ГДЕ
		|	ДокТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ДокТовары.Товар
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Товар КАК Товар,
		|	СпрТовары.Наименование КАК ТоварПредставление,
		|	ВТ.КоличествоВДокументе КАК Требуется,
		|	Остатки.Партия КАК Партия,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокПартии
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Товары КАК СпрТовары
		|		ПО ВТ.Товар = СпрТовары.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&МоментВремени,
		|			Товар В
		|				(ВЫБРАТЬ
		|					ВТ_ТоварыДокумента.Товар
		|				ИЗ
		|					ВТ_ТоварыДокумента)) КАК Остатки
		|		ПО ВТ.Товар = Остатки.Товар
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поступление КАК ДокПоступление
		|		ПО Остатки.Партия = ДокПоступление.Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	Товар ВОЗР,
		|	ДокПоступление.Дата ВОЗР,
		|	ДокПоступление.Ссылка ВОЗР
		|ИТОГИ
		|	МАКСИМУМ(ТоварПредставление),
		|	МАКСИМУМ(Требуется),
		|	СУММА(ОстатокПартии)
		|ПО
		|	Товар";
	
	ЗапросОстатковПартий.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатковПартий.УстановитьПараметр("МоментВремени", МоментВремени());
	
	Возврат ЗапросОстатковПартий.Выполнить();
	
КонецФункции

// Проверяет наличие достаточного остатка по каждому товару документа.
// При нехватке формирует понятное сообщение пользователю и выставляет флаг Отказ = Истина.
//
// Параметры:
//   Отказ                  - Булево           - признак отмены проведения.
//   РезультатЗапросаПартий - РезультатЗапроса - данные остатков по товарам.
//
Процедура ПроверитьОстаткиТоваров(Отказ, РезультатЗапросаПартий)
	
	ВыборкаПоТоварам = РезультатЗапросаПартий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоТоварам.Следующий() Цикл
		
		ОстатокТовара = ?(ВыборкаПоТоварам.ОстатокПартии = Неопределено, 0, ВыборкаПоТоварам.ОстатокПартии);
		Если ОстатокТовара < ВыборкаПоТоварам.Требуется Тогда
			
			Нехватка = ВыборкаПоТоварам.Требуется - ОстатокТовара;
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон(
				"Недостаточно товара «%1»: требуется %2 шт., доступно %3 шт. (не хватает %4 шт.). Проведение отменено.",
				ВыборкаПоТоварам.ТоварПредставление,
				ВыборкаПоТоварам.Требуется,
				ОстатокТовара,
				Нехватка
			);
			Сообщение.Поле = "Товары";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Выполняет поэтапное списание партий по принципу FIFO в регистр «ОстаткиТоваров».
//
// Параметры:
//   РезультатЗапросаПартий - РезультатЗапроса - данные остатков по партиям.
//
Процедура СписатьПартииПоFIFO(РезультатЗапросаПартий)
	
	ВыборкаПоТоварам = РезультатЗапросаПартий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПоТоварам.Следующий() Цикл
		
		ОсталосьСписать = ВыборкаПоТоварам.Требуется;
		
		ВыборкаПартий = ВыборкаПоТоварам.Выбрать();
		Пока ВыборкаПартий.Следующий() И ОсталосьСписать > 0 Цикл
			
			Если ВыборкаПартий.ОстатокПартии <= 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КоличествоК_Списанию = Мин(ОсталосьСписать, ВыборкаПартий.ОстатокПартии);
			
			Движение = Движения.ОстаткиТоваров.ДобавитьРасход();
			Движение.Период     = Дата;
			Движение.Товар      = ВыборкаПартий.Товар;
			Движение.Партия     = ВыборкаПартий.Партия;
			Движение.Количество = КоличествоК_Списанию;
			
			ОсталосьСписать = ОсталосьСписать - КоличествоК_Списанию;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

// Формирует движения по продажам в оборотный регистр накопления «Продажи».
//
Процедура СформироватьДвиженияПоПродажам()
	
	Для Каждого СтрокаТовары Из Товары Цикл
		
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период     = Дата;
		ДвижениеПродажи.Товар      = СтрокаТовары.Товар;
		ДвижениеПродажи.Контрагент = Контрагент;
		ДвижениеПродажи.Количество = СтрокаТовары.Количество;
		ДвижениеПродажи.Сумма      = СтрокаТовары.Сумма;
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти
