#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	
	// Контроль остатков перед списанием
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ДокТовары.Товар КАК Товар,
		|	СУММА(ДокТовары.Количество) КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Реализация.Товары КАК ДокТовары
		|ГДЕ
		|	ДокТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ДокТовары.Товар
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Товар КАК Товар,
		|	ВТ.Товар.Представление КАК ТоварПредставление,
		|	ВТ.КоличествоВДокументе КАК Требуется,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток,
		|	ВТ.КоличествоВДокументе - ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Нехватка
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&МоментВремени,
		|			Товар В
		|				(ВЫБРАТЬ
		|					ВТ_ТоварыДокумента.Товар
		|				ИЗ
		|					ВТ_ТоварыДокумента)) КАК Остатки
		|		ПО ВТ.Товар = Остатки.Товар
		|ГДЕ
		|	ВТ.КоличествоВДокументе > ЕСТЬNULL(Остатки.КоличествоОстаток, 0)";
	
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("МоментВремени", МоментВремени());
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		Отказ = Истина;
		Выборка = РезультатЗапроса.Выбрать();
		Пока Выборка.Следующий() Цикл
			ТекстСообщения = СтрШаблон(
				"Недостаточно товара «%1»! Требуется: %2, в наличии: %3 (не хватает: %4).",
				Выборка.ТоварПредставление,
				Выборка.Требуется,
				Выборка.Остаток,
				Выборка.Нехватка
			);
			Сообщить(ТекстСообщения);
		КонецЦикла;
		Возврат;
	КонецЕсли;
	
	// Формирование движений расхода
	Для Каждого СтрокаТовары Из Товары Цикл
		ДвижениеОстатковТоваров = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатковТоваров.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатковТоваров.Период = Дата;
		ДвижениеОстатковТоваров.Товар = СтрокаТовары.Товар;
		ДвижениеОстатковТоваров.Количество = СтрокаТовары.Количество;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти