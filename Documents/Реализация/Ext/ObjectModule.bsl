#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
#Область ИнициализацияДвижений

	// Очищаем старые движения при перепроведении (для режима AutoDeleteOnUnpost)
	Движения.ОстаткиТоваров.Записать();
	Движения.Продажи.Записать();
	
	// Включаем запись обоих регистров
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.Продажи.Записывать = Истина;

#КонецОбласти

#Область БлокировкаДанных

	// Управляемая блокировка данных по регистру остатков для предотвращения коллизий
	Блокировка = Новый БлокировкаДанных;
	ЭлементБлокировки = Блокировка.Добавить("РегистрНакопления.ОстаткиТоваров");
	ЭлементБлокировки.Режим = РежимБлокировкиДанных.Исключительный;
	ЭлементБлокировки.ИсточникДанных = Товары;
	ЭлементБлокировки.ИспользоватьИзИсточникаДанных("Товар", "Товар");
	Блокировка.Заблокировать();

#КонецОбласти

#Область КонтрольОстатковИФормированиеДвижений

	// 1. Контроль остатков перед списанием и подбор партий по FIFO
	ЗапросОстатков = Новый Запрос;
	ЗапросОстатков.Текст = 
		"ВЫБРАТЬ
		|	ДокТовары.Товар КАК Товар,
		|	СУММА(ДокТовары.Количество) КАК КоличествоВДокументе
		|ПОМЕСТИТЬ ВТ_ТоварыДокумента
		|ИЗ
		|	Документ.Реализация.Товары КАК ДокТовары
		|ГДЕ
		|	ДокТовары.Ссылка = &Ссылка
		|СГРУППИРОВАТЬ ПО
		|	ДокТовары.Товар
		|;
		|
		|ВЫБРАТЬ
		|	ВТ.Товар КАК Товар,
		|	СпрТовары.Наименование КАК ТоварПредставление,
		|	ВТ.КоличествоВДокументе КАК Требуется,
		|	Остатки.Партия КАК Партия,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокПартии
		|ИЗ
		|	ВТ_ТоварыДокумента КАК ВТ
		|	ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Товары КАК СпрТовары
		|		ПО ВТ.Товар = СпрТовары.Ссылка
		|	ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(
		|			&МоментВремени,
		|			Товар В
		|				(ВЫБРАТЬ
		|					ВТ_ТоварыДокумента.Товар
		|				ИЗ
		|					ВТ_ТоварыДокумента)) КАК Остатки
		|		ПО ВТ.Товар = Остатки.Товар
		|	ЛЕВОЕ СОЕДИНЕНИЕ Документ.Поступление КАК ДокПоступление
		|		ПО Остатки.Партия = ДокПоступление.Ссылка
		|УПОРЯДОЧИТЬ ПО
		|	Товар ВОЗР,
		|	ДокПоступление.Дата ВОЗР,
		|	ДокПоступление.Ссылка ВОЗР
		|ИТОГИ
		|	МАКСИМУМ(ТоварПредставление),
		|	МАКСИМУМ(Требуется),
		|	СУММА(ОстатокПартии)
		|ПО
		|	Товар";
	
	ЗапросОстатков.УстановитьПараметр("Ссылка", Ссылка);
	ЗапросОстатков.УстановитьПараметр("МоментВремени", МоментВремени());
	
	РезультатЗапросаОстатков = ЗапросОстатков.Выполнить();
	
	Если РезультатЗапросаОстатков.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Проверка наличия достаточного количества остатков по каждому товару
	ВыборкаТовары = РезультатЗапросаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТовары.Следующий() Цикл
		
		ОстатокТовара = ?(ВыборкаТовары.ОстатокПартии = Неопределено, 0, ВыборкаТовары.ОстатокПартии);
		Если ВыборкаТовары.Требуется > ОстатокТовара Тогда
			Отказ = Истина;
			Нехватка = ВыборкаТовары.Требуется - ОстатокТовара;
			ТекстСообщенияОбОшибке = СтрШаблон(
				"Недостаточно товара «%1»! Требуется: %2, в наличии: %3 (не хватает: %4).",
				ВыборкаТовары.ТоварПредставление,
				ВыборкаТовары.Требуется,
				ОстатокТовара,
				Нехватка
			);
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщенияОбОшибке;
			Сообщение.Сообщить();
		КонецЕсли;
		
	КонецЦикла;
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Списание остатков по партиям (FIFO)
	ВыборкаТовары = РезультатЗапросаОстатков.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаТовары.Следующий() Цикл
		
		ОсталосьСписать = ВыборкаТовары.Требуется;
		ВыборкаПартии = ВыборкаТовары.Выбрать();
		
		Пока ВыборкаПартии.Следующий() И ОсталосьСписать > 0 Цикл
			
			Если ВыборкаПартии.ОстатокПартии = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			КСписанию = Мин(ОсталосьСписать, ВыборкаПартии.ОстатокПартии);
			
			// Движение по регистру остатков (Расход с указанием партии)
			ДвижениеОстатки = Движения.ОстаткиТоваров.Добавить();
			ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеОстатки.Период      = Дата;
			ДвижениеОстатки.Товар       = ВыборкаТовары.Товар;
			ДвижениеОстатки.Партия      = ВыборкаПартии.Партия;
			ДвижениеОстатки.Количество  = КСписанию;
			
			ОсталосьСписать = ОсталосьСписать - КСписанию;
			
		КонецЦикла;
		
	КонецЦикла;

#КонецОбласти

#Область ФормированиеДвиженийПродажи

	// 2. Движения по регистру оборотов (Продажи)
	Для Каждого СтрокаТовары Из Товары Цикл
		
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период     = Дата;
		ДвижениеПродажи.Товар      = СтрокаТовары.Товар;
		ДвижениеПродажи.Контрагент = Контрагент;
		ДвижениеПродажи.Количество = СтрокаТовары.Количество;
		ДвижениеПродажи.Сумма      = СтрокаТовары.Сумма;
		
	КонецЦикла;

#КонецОбласти

КонецПроцедуры

#КонецОбласти
